# À placer derrière un nom dédié ; remplacer RELAY_HOST. Certificat : certbot (webroot), puis recharger nginx.
server {
    listen 80;
    listen [::]:80;
    server_name RELAY_HOST;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name RELAY_HOST;

    ssl_certificate /etc/letsencrypt/live/RELAY_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/RELAY_HOST/privkey.pem;

    location /ws {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8090;
    }

    location / {
        return 404;
    }
}
